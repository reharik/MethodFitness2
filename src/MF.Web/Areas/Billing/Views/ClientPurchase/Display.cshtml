@using CC.Core.Core.Html.CCUI
@using MF.Web
@model MF.Web.Areas.Billing.Controllers.PaymentViewModel

@{
    Layout = "~/Views/Shared/_DisplayLayout.cshtml";
}

@section ExtraContentHeaderButtons{
    <button class="delete" title="@WebLocalizationKeys.REMOVE"></button>
}

@* Same row/span markup as AddUpdate.cshtml. The old "col left" / "fieldRow" /
   "two-thirds" classes this view used are no longer in the stylesheets. *@
<div class="form-scroll-inner form">
    <div class="row">
        <div class="span10">
            <div class="row">
                <h5 class="stdTxtColor ml2 span8">@WebLocalizationKeys.CLIENT_PURCHASE</h5>
            </div>
            <div class="row">
                @Html.ViewFor(x => x.FullHour).Size("5").AddClassToInput("payment_input").ToHtmlTag()
            </div>
            <div class="row">
                @Html.ViewFor(x => x.FullHourTenPack).Size("5").AddClassToInput("payment_input").ToHtmlTag()
            </div>
            <div class="row">
                @Html.ViewFor(x => x.HalfHour).Size("5").AddClassToInput("payment_input").ToHtmlTag()
            </div>
            <div class="row">
                @Html.ViewFor(x => x.HalfHourTenPack).Size("5").AddClassToInput("payment_input").ToHtmlTag()
            </div>
            <div class="row">
                @Html.ViewFor(x => x.Pair).Size("5").AddClassToInput("payment_input").ToHtmlTag()
            </div>
            <div class="row">
                @Html.ViewFor(x => x.PairTenPack).Size("5").AddClassToInput("payment_input").ToHtmlTag()
            </div>
            <div class="row">
                <hr class="hrClear span5"/>
            </div>
            <div class="row">
                @Html.ViewFor(x => x.PaymentTotal).Size("5").AddClassToInput("payment_input").ToHtmlTag()
            </div>
            <div class="row">
                @Html.ViewFor(x => x.Notes).Size("8").AddClassToInput("payment_input").ToHtmlTag()
            </div>
        </div>
    </div>
</div>
@section FooterButtons
{
    @StandardButtonFor("cancel", WebLocalizationKeys.RETURN).AddClass("cancel").ToHtmlTag()
}
