@using MF.Web
@model MF.Web.Controllers.HeaderViewModel
            
    <div id="main-header">
         @*<ul id="right-tabs">
              <li id="chart-tab"><a href="">&nbsp;</a></li>
              <li id="group-tab"><a href="">&nbsp;</a></li>
         </ul>
         *@
        <span id="login-links">
        @if (Model.LoggedIn)
            {
            <a href="" class="first" id="userSettings">@Model.User.FullNameFNF </a>
            <a href="">Help</a>
                @Html.ActionLink(WebLocalizationKeys.LOG_OUT.ToString(), "Logout", "Login")
            }
        else
        {
            @Html.ActionLink(WebLocalizationKeys.SIGN_IN.ToString(), "Login", "Login")
        }
        </span>
        @if (Model.LoggedIn)
        {
            @* shown only on phones and upright tablets (mobile.css); opens the left menu *@
            <button type="button" id="menuToggle">Menu</button>
        }
    </div>
