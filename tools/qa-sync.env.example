# Copy to tools/qa-sync.env (which git ignores) and fill in.
MF_INSTANCE_ID=i-xxxxxxxxxxxxxxxxx     # the server, as shown in EC2 / Fleet Manager
MF_SYNC_BUCKET=your-private-bucket     # any private S3 bucket of yours, in us-east-2
# MF_REGION=us-east-2
# export AWS_PROFILE=your-profile      # if you use named profiles / SSO
